# Local service
HOST=0.0.0.0
PORT=3000

# Upstream OpenAI-compatible base URL
ZENMUX_BASE_URL=https://zenmux.ai/api/v1
# Optional fallback key, used only when the request has no Authorization header
ZENMUX_API_KEY=

# Storage + limits
DATA_DIR=./data
UPSTREAM_TIMEOUT_MS=900000
MAX_BODY_BYTES=33554432
# Force non-streaming upstream calls (async mode abstracts streaming)
FORCE_NON_STREAM=true
